# LM Studio (default)
AGENT_MODEL_SMALL=qwen2.5-coder-3b-instruct
AGENT_MODEL_MAIN=qwen2.5-coder-3b-instruct
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lm-studio
AGENT_LLM_PROVIDER=openai_compat

# Gemini live mode (replace model placeholders with supported model IDs)
# AGENT_MODEL_SMALL=<gemini-model>
# AGENT_MODEL_MAIN=<gemini-model>
# GEMINI_API_KEY=your_key
# AGENT_LLM_PROVIDER=gemini

# Anthropic live mode
# AGENT_MODEL_SMALL=<anthropic-model>
# AGENT_MODEL_MAIN=<anthropic-model>
# ANTHROPIC_API_KEY=your_key
# AGENT_LLM_PROVIDER=anthropic

# OpenAI live mode
# AGENT_MODEL_SMALL=<openai-model>
# AGENT_MODEL_MAIN=<openai-model>
# OPENAI_API_KEY=your_key
# AGENT_LLM_PROVIDER=openai
